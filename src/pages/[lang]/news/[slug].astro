---
import { getCollection } from "astro:content";

import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { languages, t, type Lang } from "@/lib/i18n";
import { langPath } from "@/lib/urls";

export async function getStaticPaths() {
  const all = await getCollection("news");
  const paths = [];
  for (const lang of languages) {
    const entries = all.filter((entry) => entry.id.startsWith(`${lang}/`));
    for (const entry of entries) {
      const slug = entry.slug.split("/").pop() ?? entry.slug;
      paths.push({ params: { lang, slug }, props: { entry } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection>>[number] };
const { Content } = await entry.render();

const other = lang === "zh" ? "en" : "zh";
const all = await getCollection("news");
const leaf = entry.slug.split("/").pop() ?? entry.slug;
const otherExists = all.some((item) => item.id === `${other}/${leaf}.md` || item.id === `${other}/${leaf}`);
const alternateHref = otherExists ? `/${other}/news/${leaf}/` : undefined;
const kind = entry.data.kind ?? "article";
const kindLabel = kind === "video" ? t(lang, "视频", "Video") : kind === "event" ? t(lang, "活动", "Event") : t(lang, "文章", "Article");
const bilibiliPlayerUrl = entry.data.bilibili_bvid
  ? `https://player.bilibili.com/player.html?bvid=${entry.data.bilibili_bvid}&page=1`
  : undefined;
const bilibiliWatchUrl = entry.data.bilibili_url
  ?? (entry.data.bilibili_bvid ? `https://www.bilibili.com/video/${entry.data.bilibili_bvid}/` : undefined);
---

<BaseLayout lang={lang} title={entry.data.title} alternateHref={alternateHref}>
  <SectionHeading
    eyebrow={t(lang, "内容专区", "Content Zone")}
    title={entry.data.title}
    description={entry.data.date.toISOString().slice(0, 10)}
  />

  <div class="content-detail-backlinks">
    <a class="tiny" href={langPath(lang, "/news/")}>{t(lang, "→ 返回内容专区", "→ Back to Content Zone")}</a>
  </div>

  {bilibiliPlayerUrl ? (
    <section class="content-detail-media card">
      <div class="content-detail-media-head">
        <span class={`archive-kind-badge archive-kind-badge--${kind}`}>{kindLabel}</span>
      </div>

      <div class="content-detail-embed-shell">
        <iframe
          src={bilibiliPlayerUrl}
          title={entry.data.title}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>

      <div class="content-detail-media-foot">
        <p class="content-detail-helper">
          {t(
            lang,
            "如果播放器加载不稳定，可直接前往 Bilibili 观看完整内容。",
            "If the embedded player is unavailable, open the session directly on Bilibili."
          )}
        </p>

        {bilibiliWatchUrl ? (
          <div class="content-detail-actions">
            <a class="btn btn-primary" href={bilibiliWatchUrl} target="_blank" rel="noreferrer">
              {t(lang, "前往 Bilibili 观看", "Watch on Bilibili")}
            </a>
          </div>
        ) : null}
      </div>
    </section>
  ) : null}

  <article class="card prose" style="margin-top:18px;">
    <Content />
  </article>
</BaseLayout>
